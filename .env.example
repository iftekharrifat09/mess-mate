# Frontend Environment Variables
# Copy this file to .env and update the values

# Backend API URL - Set this to your backend server address
# For local development: http://localhost:5000/api
# For production: https://your-server.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Enable/disable backend usage (default: true)
# Set to 'false' to use localStorage fallback
VITE_USE_BACKEND=true

# Optional DESCO credential encryption key (backend only; 32 bytes as 64 hex characters)
# Local development creates a persistent, ignored key file automatically when unset.
# Production must provide a stable key; keep it unchanged while encrypted DESCO credentials exist.
DESCO_ENCRYPTION_KEY=
