# Local MongoDB connection; replace with your private connection string if needed
MONGO_URI=mongodb://localhost:27017/messDB

# Backend port
PORT=5000

# Replace with a strong random value before deployment
JWT_SECRET=replace-with-a-strong-random-secret

# Optional email settings for notifications
EMAIL_USER=
EMAIL_PASS=

# Frontend origin
FRONTEND_URL=http://localhost:5173

# Optional in local development: a stable 32-byte key is generated and stored privately when unset.
# Required in production; use a stable 64-character hexadecimal value and never rotate while credentials exist.
DESCO_ENCRYPTION_KEY=